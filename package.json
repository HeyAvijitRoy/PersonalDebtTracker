{
  "name": "personal-debt-tracker",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && node --check sw.js",
    "test:rules": "firebase emulators:exec --project demo-pdt --only firestore \"node --test tests/rules/*.test.mjs\"",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o styles.css --minify",
    "test:browser": "node scripts/browser-check.mjs",
    "start": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "^15.34.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
